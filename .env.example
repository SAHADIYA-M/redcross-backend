# Copy this file to .env and adjust values for your local machine.
#   PowerShell:  Copy-Item .env.example .env
#
# Never commit the real .env file. It is for local development only.

APP_NAME=Humanitarian Needs Assessment API
APP_VERSION=0.1.0
ENVIRONMENT=development

# Comma-separated list of allowed frontend origins. "*" = allow all (development only).
CORS_ORIGINS=*

# Google Gemini API key. Get one at https://aistudio.google.com/apikey
# Do NOT commit a real key. Set your real key only in .env.
GEMINI_API_KEY=your_api_key_here

# Optional: Gemini model identifier to use for AI analysis.
GEMINI_MODEL=gemini-2.5-flash

# Optional: retry a failed AI request (transient gateway failures only) up to
# this many additional attempts, waiting a short backoff between attempts.
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=0.5

# Geocoding provider for the location pipeline.
# Available in this phase: "stub" (no credentials, offline, for development).
# When a real provider (e.g. Nominatim/OpenStreetMap or Google) is selected,
# set this to the provider name and add its API key here. Keys must never be
# committed; put them only in your local .env.
GEOCODER_PROVIDER=stub

# ---------------------------------------------------------------------------
# Authentication (Phase 13)
# ---------------------------------------------------------------------------
# JWT signing secret. The REAL secret must be set in your local .env and must
# never be committed. In a development environment an empty value falls back
# to a clearly-labelled insecure development secret so local work can start
# immediately; production refuses to start without it.
JWT_SECRET_KEY=replace-with-a-long-random-secret
# JWT signing/hashing algorithm (HS256 is the sensible default).
JWT_ALGORITHM=HS256
# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Role assigned by public registration. Never ADMIN by design; the only
# controlled options are assessment/reviewer/responder/viewer roles.
PUBLIC_REGISTER_ROLE=VIEWER
# Development-only admin seed. Keep OFF in production.
# When enabled (and ENVIRONMENT != production) a single development admin is
# created on startup from the two credentials below. Development only.
SEED_DEV_ADMIN=false
DEV_ADMIN_USERNAME=dev_admin
DEV_ADMIN_PASSWORD=change-me-dev-admin-password