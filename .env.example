# Copy this file to .env and adjust values for your local machine.
#   PowerShell:  Copy-Item .env.example .env
#
# Never commit the real .env file. It is for local development only.

APP_NAME=Humanitarian Needs Assessment API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Comma-separated list of allowed frontend origins. "*" = allow all (development only).
CORS_ORIGINS=*