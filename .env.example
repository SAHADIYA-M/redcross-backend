GEMINI_API_KEY=YOUR_REAL_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-flash

JWT_SECRET_KEY=YOUR_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

DATABASE_URL=YOUR_REAL_SUPABASE_DATABASE_URL

# Create missing Phase 15 tables at startup (development only). Default: false.
# DB_CREATE_TABLES_ON_STARTUP=false
# Enforce that required tables exist at startup (default: on outside development).
# DB_ENFORCE_SCHEMA_READY=true
# Seed the development admin at startup (development only). Default: false.
# SEED_DEV_ADMIN=false