# Application Configuration
APP_NAME="Humanitarian Needs Assessment API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"

# CORS configuration (comma separated URLs of your frontend)
# Note: For production, specify the exact domains, e.g. https://my-frontend.vercel.app
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:8000,*"

# Database (Leave empty for in-memory / file-based storage, or provide PostgreSQL URI)
# Example: postgresql://user:password@localhost:5432/humanitarian_db
DATABASE_URL=""

# AI Service Configuration
# Your Google Gemini API Key from Google AI Studio
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=0.5

# Geocoding Provider: "stub" or "external"
GEOCODER_PROVIDER="stub"

# Database initialization flags
USE_PERSISTENT_DB="true"
DATA_DIR="data"
DB_CREATE_TABLES_ON_STARTUP="false"
DB_ENFORCE_SCHEMA_READY="false"
